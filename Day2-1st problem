import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        boolean flag=false;
        if(n==0||n==1)
        {
            flag=false;
        }
        if(n==2)
        {
            flag=true;
        }
        for(int i=2;i<=n/2;i++)
        {
            if(n%i==0)
            {
                flag=false;
            }
            else
            {
                flag=true;
            }
        }
        if(flag)
        {
            System.out.println("Prime");
        }
        else
        {
            System.out.println("False");
        }
    }
}
